# Neon Postgres connection string; keep this server-only.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# UID of the one authorized admin account in the configured Firebase project.
FIREBASE_ADMIN_UID=replace-with-the-admin-user-uid-from-firebase-console

# Configure a connected private Vercel Blob store.
# Vercel OIDC variables are supplied automatically for connected deployments.
# For local development, obtain these from Vercel and do not commit real values.
BLOB_READ_WRITE_TOKEN=replace-with-your-blob-token
BLOB_WEBHOOK_PUBLIC_KEY=replace-with-your-blob-webhook-public-key
